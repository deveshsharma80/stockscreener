# Optional: require this secret on every webhook call
# (X-Webhook-Secret header, Authorization: Bearer <secret>, or ?secret=<secret>)
WEBHOOK_SECRET=

# Optional: force the storage driver. "local" = ./data/*.json, "blob" = Vercel Blob.
# Default: blob on Vercel or when Blob credentials are present, otherwise local.
DB_DRIVER=

# Optional: default target % for Chartink PotentialProfit when the URL has no ?target=
CHARTINK_TARGET_PCT=5
