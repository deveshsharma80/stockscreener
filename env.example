# Optional: require this secret on every webhook call
# (X-Webhook-Secret header, Authorization: Bearer <secret>, or ?secret=<secret>)
WEBHOOK_SECRET=

# Optional (recommended): a second, limited secret for outside senders. It only works for
# the Chartink webhook, ?action=check-orders and the crypto ?action=scan — it can't trade,
# reset or delete. Use it in Chartink and cron-job.org URLs; keep WEBHOOK_SECRET private.
CRON_SECRET=

# Optional: force the storage driver. "local" = ./data/*.json, "blob" = Vercel Blob.
# Default: blob on Vercel or when Blob credentials are present, otherwise local.
DB_DRIVER=

# Optional: default target % for Chartink PotentialProfit when the URL has no ?target=
CHARTINK_TARGET_PCT=5

# Optional: run the Ticker page with simulated prices (no Dhan account needed)
DHAN_MOCK=

# Optional: paper-trading brokerage, % of trade value per buy and per sell (default 1)
PAPER_BROKERAGE_PCT=

# Optional: Equity Intraday leverage for paper trading (default 4)
PAPER_INTRADAY_LEVERAGE=

# Optional: paper brokerage per side, % of trade value (defaults: options 1, intraday 0.025)
PAPER_BROKERAGE_PCT_OPTIONS=
PAPER_BROKERAGE_PCT_INTRADAY=

# Dashboard sign-in password. When set, the whole app asks for it first.
# Use a long one (e.g. 4+ random words). Changing it signs everyone out.
APP_PASSWORD=
