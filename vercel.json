{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ticker.js": {
      "maxDuration": 60
    },
    "api/crypto.js": {
      "maxDuration": 60
    }
  },
  "regions": [
    "bom1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
